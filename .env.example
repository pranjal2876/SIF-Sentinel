# SIF Sentinel Environment Configuration
# Copy to .env and adjust as needed

# Local development defaults to SQLite
DATABASE_URL=sqlite:///./data/sifsentinel.db

# Production PostgreSQL with pgvector target:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sifsentinel

# AI / ML Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CLUSTER_EPS=0.45
CLUSTER_MIN_SAMPLES=2
SIMILARITY_THRESHOLD=0.75

# Optional LLM Flag (Core system works 100% locally with rule+embeddings; no API key required)
LLM_ENABLED=false

# Optional API Keys (Only if LLM_ENABLED=true)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string
CORS_ORIGINS=["http://localhost:3000"]
